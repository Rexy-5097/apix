# Normalise line endings so a Windows checkout and a Linux CI runner agree.
# Contributors work on Windows; CI runs on ubuntu-latest.
* text=auto eol=lf

# Shell scripts and Git hooks MUST be LF. With core.autocrlf=true on Windows a
# CRLF hook fails on macOS and Linux with "bad interpreter: no such file or
# directory", which is a confusing way to discover a line-ending problem.
*.sh            text eol=lf
.githooks/*     text eol=lf

# Windows-only scripts keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary — never touched, never diffed as text.
*.pdf           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.parquet       binary
*.xlsx          binary

# Generated or vendored: keep out of diff noise and language statistics.
.claude/skills/**       linguist-vendored
.claude/references/**   linguist-vendored
skills-lock.json        linguist-generated
