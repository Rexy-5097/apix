# .gitignore — AgentOS Template

# ─── Environment and Secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.cert
secrets/

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ─── Node / JavaScript ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.svelte-kit/
.turbo/

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── OS and Editor ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Data and Large Files ──────────────────────────────────────────────────
*.csv
# Except the collection templates: they are documentation the procedure links
# to, not collected data, and they must ship with it.
!tools/collection/templates/*.csv
*.parquet
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
data/raw/
data/processed/

# ─── ML / AI Artifacts ─────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
*.bin
checkpoints/
runs/
wandb/
mlruns/
.neptune/

# ─── Infrastructure and Build ──────────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
.serverless/
.amplify/
cdk.out/

# ─── Docker ────────────────────────────────────────────────────────────────
.dockerignore

# ─── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Temporary and Cache ───────────────────────────────────────────────────
tmp/
temp/
.cache/
.tmp/
*.tmp
*.bak
*.orig

# ─── AgentOS Specific ──────────────────────────────────────────────────────
# Add project-specific ignores below this line

# Personal Claude Code permissions — never shared
.claude/settings.local.json

# Collected fare evidence. Retained for five years per the acquisition protocol,
# but retention is not version control: this holds a SQLite store of live fares
# and screenshots of a carrier's own pages, and pushing those to a public remote
# would redistribute their content. An evidence archive is a separate, owner-led
# decision -- see compliance/manual-collection-procedure.md section 9.
data/collection/
